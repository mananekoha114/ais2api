 using namespace intl::LanguageTagLimits;
 
+// The embedding's default locale on this thread (the identity's
+// navigator.language). When set it stands in for ICU's default locale;
+// locales a script names itself are left alone.
+static thread_local std::string sEmbeddingDefaultLocale;
+
+const char* Locale::GetDefaultLocale() {
+  return sEmbeddingDefaultLocale.empty() ? uloc_getDefault()
+                                         : sEmbeddingDefaultLocale.c_str();
+}
+
+}  // namespace mozilla::intl
+
+// mozjs_set_camou_locale sets this thread's default locale; an empty or null
+// locale restores ICU's.
+extern "C" MOZ_EXPORT void mozjs_set_camou_locale(const char* locale) {
+  mozilla::intl::sEmbeddingDefaultLocale = locale ? locale : "";
+}
