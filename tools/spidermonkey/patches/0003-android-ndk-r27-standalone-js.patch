+if CONFIG["OS_TARGET"] == "Android" and not CONFIG["JS_STANDALONE"]:
     LDFLAGS += ["-Wl,--version-script,%s/mozglue.ver" % SRCDIR]
     SOURCES += [
         "BionicGlue.cpp",
