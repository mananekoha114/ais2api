{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ais2api.local/schemas/protocol-extensions.schema.json",
  "title": "ais2api protocol extensions version 1",
  "description": "Schemas for the ais2api property only. Standard Gemini/OpenAI properties remain defined by their respective protocols.",
  "$defs": {
    "errorExtension": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "partial_response": {
          "type": "object",
          "description": "Already received result in the requested Gemini, Chat Completions or Responses format, attached to a failed non-streaming response. No successful finish is implied; the HTTP error remains authoritative. Bounded by the configured aggregate limit and protocol conversion overhead."
        }
      }
    },
    "clientToolCallId": {
      "type": "string",
      "description": "Opaque OpenAI tool ID. call_gemini_ IDs carry base64url JSON [original ID or null, thought signature or null, nonce]; clients must return them unchanged. Decoded signatures are not authentication tokens."
    },
    "assistantCompatibilityFields": {
      "type": "object",
      "description": "Additional OpenAI assistant message/delta fields. Native gemini_content is authoritative when provided; compatibility fields must agree with it.",
      "properties": {
        "reasoning_content": {"type": "string"},
        "thought_signature": {"type": "string"},
        "signature": {"type": "string", "description": "Input alias for thought_signature; both must agree if present."}
      }
    },
    "part": {
      "type": "object",
      "properties": {
        "text": {"type": "string"},
        "thought": {"type": "boolean"},
        "thoughtSignature": {"type": "string"},
        "inlineData": {
          "type": "object", "required": ["mimeType", "data"], "additionalProperties": false,
          "properties": {"mimeType": {"type": "string", "minLength": 1}, "data": {"type": "string", "minLength": 1}}
        },
        "functionCall": {"$ref": "#/$defs/functionCall"},
        "functionResponse": {
          "type": "object", "required": ["name", "response"], "additionalProperties": false,
          "properties": {"name": {"type": "string", "minLength": 1}, "id": {"type": "string"}, "response": {"type": "object"}, "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}}}
        },
        "executableCode": {"type": "object", "required": ["code"], "properties": {"code": {"type": "string"}, "language": {"type": "string"}}},
        "codeExecutionResult": {"type": "object", "required": ["output"], "properties": {"output": {"type": "string"}, "outcome": {"type": "string"}}}
      },
      "additionalProperties": false,
      "oneOf": [
        {"required": ["text"]}, {"required": ["inlineData"]}, {"required": ["functionCall"]},
        {"required": ["functionResponse"]}, {"required": ["executableCode"]}, {"required": ["codeExecutionResult"]},
        {"required": ["thoughtSignature"], "not": {"anyOf": [
          {"required": ["text"]}, {"required": ["inlineData"]}, {"required": ["functionCall"]},
          {"required": ["functionResponse"]}, {"required": ["executableCode"]}, {"required": ["codeExecutionResult"]}
        ]}}
      ]
    },
    "functionCall": {
      "type": "object", "required": ["name"], "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1}, "id": {"type": "string"}, "args": {"type": "object"}}
    },
    "content": {
      "type": "object", "required": ["parts"], "additionalProperties": false,
      "properties": {"role": {"enum": ["user", "model", "system"]}, "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}}}
    },
    "generationConfig": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "stopSequences": {"type": "array", "items": {"type": "string"}},
        "maxOutputTokens": {"type": "integer", "minimum": 0},
        "temperature": {"type": "number"}, "topP": {"type": "number"}, "topK": {"type": "integer", "minimum": 0},
        "responseMimeType": {"type": "string"}, "responseSchema": {"type": "object"},
        "presencePenalty": {"type": "number"}, "frequencyPenalty": {"type": "number"},
        "responseLogprobs": {"type": "boolean"}, "logprobs": {"type": "integer", "minimum": 0},
        "responseModalities": {"type": "array", "items": {"enum": ["TEXT", "IMAGE"]}},
        "thinkingConfig": {
          "type": "object", "additionalProperties": false,
          "properties": {"thinkingLevel": {"enum": ["MINIMAL", "LOW", "MEDIUM", "HIGH"]}}
        },
        "mediaResolution": {"enum": ["MEDIA_RESOLUTION_LOW", "MEDIA_RESOLUTION_MEDIUM", "MEDIA_RESOLUTION_HIGH"]},
        "imageConfig": {"type": "object", "additionalProperties": false, "properties": {"aspectRatio": {"type": "string"}, "imageSize": {"type": "string"}}}
      }
    },
    "requestExtension": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "gemini": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "generationConfig": {"$ref": "#/$defs/generationConfig"},
            "systemInstruction": {"$ref": "#/$defs/content"},
            "tools": {"type": "array", "items": {"$ref": "#/$defs/tool"}},
            "toolConfig": {"$ref": "#/$defs/toolConfig"},
            "safetySettings": {"type": "array", "items": {"type": "object"}}
          }
        }
      }
    },
    "toolConfig": {
      "type": "object", "additionalProperties": false,
      "properties": {"includeServerSideToolInvocations": {"type": "boolean", "description": "Accepted for client compatibility and reported as ignored; the private gateway has no verified invocation-record control."}, "functionCallingConfig": {
        "type": "object", "additionalProperties": false,
        "properties": {"mode": {"enum": ["AUTO", "NONE"]}, "allowedFunctionNames": {"type": "array", "items": {"type": "string"}}}
      }}
    },
    "emptyTool": {"type": "object", "additionalProperties": false},
    "tool": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "functionDeclarations": {"type": "array", "items": {"type": "object"}},
        "codeExecution": {"$ref": "#/$defs/emptyTool"}, "googleMaps": {"$ref": "#/$defs/emptyTool"},
        "urlContext": {"$ref": "#/$defs/emptyTool"},
        "googleSearchRetrieval": {
          "type": "object", "additionalProperties": false,
          "description": "Maps to modern Google Search. Legacy dynamic retrieval controls are validated and reported as ignored.",
          "properties": {"dynamicRetrievalConfig": {
            "type": "object", "additionalProperties": false,
            "properties": {"mode": {"enum": ["MODE_UNSPECIFIED", "MODE_DYNAMIC"]}, "dynamicThreshold": {"type": "number", "minimum": 0, "maximum": 1}}
          }}
        },
        "googleSearch": {
          "type": "object", "additionalProperties": false,
          "properties": {"searchTypes": {
            "type": "object", "additionalProperties": false,
            "properties": {"webSearch": {"$ref": "#/$defs/emptyTool"}, "imageSearch": {"$ref": "#/$defs/emptyTool"}}
          }}
        }
      }
    },
    "assistantExtension": {
      "type": "object", "required": ["gemini_content"], "additionalProperties": false,
      "properties": {
        "gemini_content": {"allOf": [{"$ref": "#/$defs/content"}, {"properties": {"role": {"const": "model"}}}]}
      }
    },
    "deltaExtension": {
      "type": "object", "required": ["gemini_delta"], "additionalProperties": false,
      "properties": {"gemini_delta": {"type": "object", "description": "The entire normalized Gemini response chunk, including candidates, part signatures, finish and usage metadata."}}
    }
  },
  "$ref": "#/$defs/requestExtension"
}
