# Embeds browser/camoufox: catalog.json and every file it lists, each checked
# against the sha256 recorded there (scripts/camoufox-dev.py catalog writes both).
file(READ "${SOURCE_DIR}/catalog.json" catalog)
file(SHA256 "${SOURCE_DIR}/catalog.json" catalog_sha256)
string(JSON file_count LENGTH "${catalog}" files)
if(file_count EQUAL 0)
  message(FATAL_ERROR "browser/camoufox/catalog.json lists no files")
endif()
set(arrays "")
set(entries "")
set(names catalog.json)
math(EXPR last "${file_count} - 1")
foreach(index RANGE ${last})
  string(JSON name MEMBER "${catalog}" files ${index})
  list(APPEND names "${name}")
endforeach()
set(index 0)
foreach(name IN LISTS names)
  set(path "${SOURCE_DIR}/${name}")
  if(NOT name STREQUAL "catalog.json")
    string(JSON expected GET "${catalog}" files "${name}")
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "browser/camoufox/${name} does not match catalog.json; rerun scripts/camoufox-dev.py catalog")
    endif()
  endif()
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" hex_length)
  if(hex_length EQUAL 0 OR hex_length GREATER 1048576)
    message(FATAL_ERROR "browser/camoufox/${name} must contain 1..524288 bytes")
  endif()
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND arrays "static constexpr unsigned char embedded_camoufox_${index}[] = {${bytes}};\n")
  string(APPEND entries "    {\"${name}\", embedded_camoufox_${index}, sizeof(embedded_camoufox_${index})},\n")
  math(EXPR index "${index} + 1")
endforeach()
get_filename_component(output_directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
file(WRITE "${OUTPUT}" "// Generated; do not edit.\n${arrays}static constexpr EmbeddedFile embedded_camoufox_files[] = {\n${entries}};\nstatic constexpr std::string_view embedded_camoufox_digest = \"${catalog_sha256}\";\n")
