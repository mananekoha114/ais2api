# Embeds the fpgen model in a dev bundle: every file runtime-manifest.json's
# fpgen_model pins, each checked against its sha256 there.
file(READ "${MANIFEST}" manifest)
string(JSON tag GET "${manifest}" fpgen_model tag)
if(NOT tag MATCHES "^[A-Za-z0-9._/-]+$")
  message(FATAL_ERROR "runtime-manifest.json pins an fpgen model with an invalid tag")
endif()
string(JSON file_count LENGTH "${manifest}" fpgen_model file_sha256)
if(file_count EQUAL 0)
  message(FATAL_ERROR "runtime-manifest.json pins no fpgen model files")
endif()
set(arrays "")
set(entries "")
math(EXPR last "${file_count} - 1")
foreach(index RANGE ${last})
  string(JSON name MEMBER "${manifest}" fpgen_model file_sha256 ${index})
  string(JSON expected GET "${manifest}" fpgen_model file_sha256 "${name}")
  if(NOT name MATCHES "^[A-Za-z0-9_-][A-Za-z0-9._-]*$")
    message(FATAL_ERROR "runtime-manifest.json pins an fpgen model file with an invalid name")
  endif()
  set(path "${MODEL_DIR}/${name}")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "${path} is missing; scripts/build-dev.ps1 downloads the pinned model")
  endif()
  file(SHA256 "${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${path} does not match its sha256 in runtime-manifest.json")
  endif()
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" hex_length)
  if(hex_length EQUAL 0 OR hex_length GREATER 16777216)
    message(FATAL_ERROR "${path} must contain 1..8388608 bytes")
  endif()
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND arrays "static constexpr unsigned char embedded_fpgen_${index}[] = {${bytes}};\n")
  string(APPEND entries "    {\"${name}\", embedded_fpgen_${index}, sizeof(embedded_fpgen_${index}), \"${expected}\"},\n")
endforeach()
get_filename_component(output_directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
file(WRITE "${OUTPUT}" "// Generated; do not edit.\n${arrays}static constexpr EmbeddedModelFile embedded_fpgen_files[] = {\n${entries}};\nstatic constexpr std::string_view embedded_fpgen_tag = \"${tag}\";\n")
